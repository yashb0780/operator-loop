# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your keys stay on your machine.

# Claude API key, from https://console.anthropic.com
ANTHROPIC_API_KEY=

# LangSmith API key, from https://smith.langchain.com (Settings > API Keys)
LANGSMITH_API_KEY=

# Turn on tracing so every agent run shows up in LangSmith
LANGSMITH_TRACING=true

# The LangSmith project where traces are stored
LANGSMITH_PROJECT=operator-loop

# Only needed if your LangSmith account is in the EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Your name, recorded in the CHANGELOG when you approve a rule
OPERATOR_NAME=
